# Copia in .env solo se ti serve cambiare qualcosa: nessun valore è obbligatorio.
# (npm start non legge .env da solo: imposta le variabili nel Terminale, es. PORT=9000 npm start)

# Porta del server (predefinita 8080)
PORT=8080
# Indirizzo di ascolto: 0.0.0.0 = raggiungibile dal telefono in rete locale
HOST=0.0.0.0
# Cartella dei dati (predefinita ./data)
DATA_DIR=
# Imposta/forza la password del CMS a ogni avvio (altrimenti viene generata al primo avvio)
ADMIN_PASSWORD=
# Solo dietro HTTPS (pubblicazione futura): cookie Secure e proxy fidato
COOKIE_SECURE=0
TRUST_PROXY=0
