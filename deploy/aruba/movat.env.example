# Impostazioni di MÖVAT! sul server. Dopo ogni modifica: systemctl restart movat
# Questo file contiene chiavi segrete: non condividerlo.

NODE_ENV=production
PUBLIC_URL=https://__DOMAIN__
HOST=127.0.0.1
PORT=8000
DATA_DIR=/var/lib/movat
# Caddy è l'unico proxy davanti all'app
TRUST_PROXY_HOPS=1

# Cloudflare Turnstile (obbligatorio: senza chiavi voti, proposte e messaggi vengono rifiutati)
# https://dash.cloudflare.com → Turnstile → Add widget → dominio __DOMAIN__, modalità Managed
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (facoltative): notifiche agli autori e al team. Con una casella Aruba:
# SMTP_HOST=smtps.aruba.it
# SMTP_PORT=465
# SMTP_USER=movat@busalogistica.it
# SMTP_PASS=la-password-della-casella
# SMTP_FROM="MÖVAT! <movat@busalogistica.it>"
