# Caddy ottiene e rinnova da solo il certificato HTTPS (Let's Encrypt).
__DOMAIN__ {
	encode zstd gzip
	# Upload del CMS (immagini e audio) fino a 25 MB
	request_body {
		max_size 26MB
	}
	reverse_proxy 127.0.0.1:8000
	log {
		output file /var/log/caddy/movat.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
